// Finite-amplitude Rossby Wave Diagnostics (zonal-mean version)
//
// This POD requires 6-hourly zonal wind, meridional wind, and air temperature
// on pressure levels.
//
{
   "settings":{
      "driver":"finite_amplitude_wave_diag_zonal_mean.py",
      "long_name":"Finite-amplitude Rossby Wave Diagnostics (zonal-mean version)",
      "convention":"cmip",
      "description":"Finite-amplitude Rossby Wave Diagnostics (zonal-mean version)",
      "runtime_requirements":{
         "python3":[
            "matplotlib",
            "xarray",
            "netCDF4",
            "numpy",
            "cartopy",
            "falwa"
         ]
      }
   },
   "dimensions":{
      "lat":{
         "standard_name":"latitude",
         "units":"degrees_north",
         "axis":"Y"
      },
      "lon":{
         "standard_name":"longitude",
         "units":"degrees_east",
         "axis":"X"
      },
      "plev":{
         "standard_name":"air_pressure",
         "units":"Pa",
         "positive":"down",
         "axis":"Z"
      },
      "time":{"standard_name":"time"}
   },
   "varlist":{
      "ua":{
         "standard_name":"eastward_wind",
         "realm":"atmos",
         "units":"m s-1",
         "frequency":"6hr",
         "dimensions":["time", "plev", "lat", "lon"]
      },
      "va":{
         "standard_name":"northward_wind",
         "realm":"atmos",
         "units":"m s-1",
         "frequency":"6hr",
         "dimensions":["time", "plev", "lat", "lon"]
      },
      "ta":{
         "standard_name":"air_temperature",
         "realm":"atmos",
         "units":"K",
         "frequency":"6hr",
         "dimensions":["time", "plev", "lat", "lon"]
      }
   }
}
