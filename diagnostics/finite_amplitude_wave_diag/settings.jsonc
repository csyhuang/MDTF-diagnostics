// Finite-amplitude Rossby Wave Diagnostics (zonal-mean version)
//
// This POD requires 6-hourly zonal wind, meridional wind, and air temperature
// on pressure levels.
//
{
   "settings":{
      // The driver is the notebook: the framework maps .ipynb -> jupyter
      // (src/pod_setup.py:75) and runs `nbconvert --to html --execute`,
      // rendering the executed notebook to
      // finite_amplitude_wave_diag_zonal_mean_ipynb.html in WORK_DIR.
      // The computation lives in
      // finite_amplitude_wave_diag_zonal_mean_rework.py, which the notebook
      // imports and which can also be run directly.
      "driver":"finite_amplitude_wave_diag_zonal_mean.ipynb",
      "long_name":"Finite-amplitude Rossby Wave Diagnostics (zonal-mean version)",
      "convention":"cmip",
      "description":"Finite-amplitude Rossby Wave Diagnostics (zonal-mean version)",
      "runtime_requirements":{
         "python3":[
            "matplotlib",
            "xarray",
            "netCDF4",
            "numpy",
            "cartopy",
            "falwa",
            "gridfill",
            "intake-esm",
            "pyyaml",
            "jupyter",
            "nbconvert"
         ]
      }
   },
   "dimensions":{
      "lat":{
         "standard_name":"latitude",
         "units":"degrees_north",
         "axis":"Y"
      },
      "lon":{
         "standard_name":"longitude",
         "units":"degrees_east",
         "axis":"X"
      },
      "plev":{
         "standard_name":"air_pressure",
         "units":"Pa",
         "positive":"down",
         "axis":"Z"
      },
      "time":{"standard_name":"time"}
   },
   "varlist":{
      "ua":{
         "standard_name":"eastward_wind",
         "realm":"atmos",
         "units":"m s-1",
         "frequency":"6hr",
         "dimensions":["time", "plev", "lat", "lon"]
      },
      "va":{
         "standard_name":"northward_wind",
         "realm":"atmos",
         "units":"m s-1",
         "frequency":"6hr",
         "dimensions":["time", "plev", "lat", "lon"]
      },
      "ta":{
         "standard_name":"air_temperature",
         "realm":"atmos",
         "units":"K",
         "frequency":"6hr",
         "dimensions":["time", "plev", "lat", "lon"]
      }
   }
}
